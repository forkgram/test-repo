diff --git a/external/qt/CMakeLists.txt b/external/qt/CMakeLists.txt
index 9845f55..a1a0eaa 100644
--- a/external/qt/CMakeLists.txt
+++ b/external/qt/CMakeLists.txt
@@ -215,9 +215,27 @@ if (WIN32)
             D3D12
             SetupAPI
             Shcore
-            Synchronization
-            WindowsApp
         )
+        if (build_winarm)
+            # Windows on ARM starts at Windows 10, where both umbrella import
+            # libraries exist - and qtbase is built there without the Windows 7
+            # overlay, so it imports UI Automation and ICU directly and
+            # WindowsApp is what resolves them.
+            target_link_libraries(external_qt
+            INTERFACE
+                Synchronization
+                WindowsApp
+            )
+        else()
+            # Windows 7 has neither umbrella library, so name what qtbase
+            # actually uses out of them.
+            target_link_libraries(external_qt
+            INTERFACE
+                Secur32
+                WinHttp
+                ncrypt
+            )
+        endif()
     else()
         target_link_libraries(external_qt
         INTERFACE
